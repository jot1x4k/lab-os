set terminal pngcairo size 1024,440 font "sans,10"
set output 'test/taller_srt.png'
set title "Diagrama de Gantt"
set xlabel "Tiempo"
set ylabel "Proceso"
set xrange [0:17]
set yrange [0:5]
set xtics 1
set grid xtics
unset key
set ytics ("P1" 4, "P2" 3, "P3" 2, "P4" 1)
set object 1 rect from 0,3.7 to 2,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 2 rect from 2,3.92 to 4,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 3 rect from 4,3.92 to 6,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 4 rect from 6,3.92 to 8,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 5 rect from 8,3.92 to 10,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 6 rect from 10,3.92 to 11,4.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 7 rect from 11,3.7 to 13,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 8 rect from 13,3.7 to 15,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 9 rect from 15,3.7 to 16,4.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 10 rect from 2,2.7 to 4,3.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 11 rect from 4,2.7 to 6,3.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 12 rect from 4,1.92 to 6,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 13 rect from 6,1.92 to 8,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 14 rect from 8,1.92 to 10,2.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 15 rect from 10,1.7 to 11,2.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 16 rect from 5,0.92 to 6,1.08 fc rgb "#bdbdbd" fs solid 1.0 border lc rgb "#424242"
set object 17 rect from 6,0.7 to 8,1.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
set object 18 rect from 8,0.7 to 10,1.3 fc rgb "#2e7d32" fs solid 1.0 border lc rgb "#424242"
plot -1 notitle
